                    </subviews>
                </stackView>
            </subviews>
            <color key="backgroundColor" systemColor="systemBackgroundColor"/>
            <constraints>
                <constraint firstAttribute="trailing" secondItem="main-stack-view-id" secondAttribute="trailing" constant="16" id="main-stack-trailing-constraint"/>
                <constraint firstItem="main-stack-view-id" firstAttribute="top" secondItem="root-view-id" secondAttribute="top" constant="16" id="main-stack-top-constraint"/>
